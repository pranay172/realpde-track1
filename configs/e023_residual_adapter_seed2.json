{
  "experiment": "E023_adapter3",
  "seed": 20260816,
  "hypothesis": "Training an additional diverse seed and capacity (h=32, AdamW) residual adapter on frozen E005 CNO will provide complementary high-frequency corrections for the shared-backbone ensemble.",
  "comparator": "E019 persist-first-4: Rel-L2 94.619, MVPE 95.302, TKE 72.255, SPS 38.645",
  "split_config": "configs/e002_split.json",
  "initial_checkpoint": "artifacts/e005_scale_balanced_uv/final.pth",
  "model": {
    "wrapper": "residual_cno",
    "base_model_type": "cno",
    "trainable": "adapter_only",
    "backbone_mode": "eval",
    "adapter": {
      "name": "residual_conv3d",
      "input": "concat_input_and_backbone",
      "in_channels": 6,
      "out_channels": 3,
      "hidden_channels": 32,
      "n_blocks": 2,
      "kernel_size": 3,
      "zero_init_last": true
    }
  },
  "data": {
    "window_stride": 20,
    "input_frames": 20,
    "output_frames": 20,
    "spatial_stride": 2,
    "normalization": "unchanged E003/E005 per-channel Gaussian statistics over every training-window element",
    "pressure": "exactly zero",
    "shuffle": true,
    "num_workers": 0,
    "pin_memory": true,
    "preload_trajectories": true
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "betas": [0.9, 0.999],
    "weight_decay": 0.0001,
    "scheduler": "CosineAnnealingLR",
    "eta_min": 0.0,
    "batch_size": 4,
    "num_updates": 600,
    "loss": {
      "name": "per_window_physical_relative_mse",
      "measured_channels": 2,
      "denominator_epsilon": 1e-12
    },
    "precision": "float32",
    "gradient_clip_norm": 1.0,
    "checkpoint_selection": "fixed final update; no validation-based early stopping",
    "maximum_wall_minutes": 40
  },
  "evaluation": {
    "fold": "A",
    "arrays": "artifacts/e002_validation/arrays",
    "batch_size": 4,
    "persist_first_frames": 4
  }
}
